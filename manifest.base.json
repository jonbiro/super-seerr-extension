{
  "manifest_version": 3,
  "name": "Super Seerr",
  "version": "3.5.261",
  "description": "Request movies and TV from nine discovery sites, with ratings, filters and optional Trakt/Simkl watchlists for Seerr.",
  "permissions": [
    "storage",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://www.imdb.com/*",
    "https://imdb.com/*",
    "https://www.rottentomatoes.com/*",
    "https://rottentomatoes.com/*",
    "https://www.themoviedb.org/*",
    "https://themoviedb.org/*",
    "https://letterboxd.com/*",
    "https://www.letterboxd.com/*",
    "https://www.metacritic.com/*",
    "https://metacritic.com/*",
    "https://trakt.tv/*",
    "https://www.trakt.tv/*",
    "https://app.trakt.tv/*",
    "https://www.filmweb.pl/*",
    "https://filmweb.pl/*",
    "https://simkl.com/*",
    "https://www.simkl.com/*",
    "https://www.justwatch.com/*",
    "https://justwatch.com/*",
    "https://*.justwatch.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.imdb.com/title/*",
        "https://imdb.com/title/*"
      ],
      "js": [
        "src/shared/MediaValidation.js",
        "src/shared/SeerrClient.js",
        "src/shared/MediaExtractor.js",
        "src/shared/SeasonPicker.js",
        "src/shared/NotificationCenter.js",
        "src/shared/UIComponents.js",
        "src/shared/BaseIntegration.js",
        "src/content/imdb-integration.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.rottentomatoes.com/m/*",
        "https://rottentomatoes.com/m/*",
        "https://www.rottentomatoes.com/tv/*",
        "https://rottentomatoes.com/tv/*"
      ],
      "js": [
        "src/shared/MediaValidation.js",
        "src/shared/SeerrClient.js",
        "src/shared/MediaExtractor.js",
        "src/shared/SeasonPicker.js",
        "src/shared/NotificationCenter.js",
        "src/shared/UIComponents.js",
        "src/shared/BaseIntegration.js",
        "src/content/rt-integration.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.themoviedb.org/movie/*",
        "https://themoviedb.org/movie/*",
        "https://www.themoviedb.org/tv/*",
        "https://themoviedb.org/tv/*"
      ],
      "js": [
        "src/shared/MediaValidation.js",
        "src/shared/SeerrClient.js",
        "src/shared/MediaExtractor.js",
        "src/shared/SeasonPicker.js",
        "src/shared/NotificationCenter.js",
        "src/shared/UIComponents.js",
        "src/shared/BaseIntegration.js",
        "src/content/tmdb-integration.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://letterboxd.com/film/*",
        "https://www.letterboxd.com/film/*"
      ],
      "js": [
        "src/shared/MediaValidation.js",
        "src/shared/SeerrClient.js",
        "src/shared/MediaExtractor.js",
        "src/shared/SeasonPicker.js",
        "src/shared/NotificationCenter.js",
        "src/shared/UIComponents.js",
        "src/shared/BaseIntegration.js",
        "src/content/letterboxd-integration.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.metacritic.com/movie/*",
        "https://metacritic.com/movie/*",
        "https://www.metacritic.com/tv/*",
        "https://metacritic.com/tv/*"
      ],
      "js": [
        "src/shared/MediaValidation.js",
        "src/shared/SeerrClient.js",
        "src/shared/MediaExtractor.js",
        "src/shared/SeasonPicker.js",
        "src/shared/NotificationCenter.js",
        "src/shared/UIComponents.js",
        "src/shared/BaseIntegration.js",
        "src/content/metacritic-integration.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://trakt.tv/movies/*",
        "https://www.trakt.tv/movies/*",
        "https://app.trakt.tv/movies/*",
        "https://trakt.tv/movie/*",
        "https://www.trakt.tv/movie/*",
        "https://app.trakt.tv/movie/*",
        "https://trakt.tv/shows/*",
        "https://www.trakt.tv/shows/*",
        "https://app.trakt.tv/shows/*",
        "https://trakt.tv/show/*",
        "https://www.trakt.tv/show/*",
        "https://app.trakt.tv/show/*"
      ],
      "js": [
        "src/shared/MediaValidation.js",
        "src/shared/SeerrClient.js",
        "src/shared/MediaExtractor.js",
        "src/shared/SeasonPicker.js",
        "src/shared/NotificationCenter.js",
        "src/shared/UIComponents.js",
        "src/shared/BaseIntegration.js",
        "src/content/trakt-integration.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.filmweb.pl/film/*",
        "https://filmweb.pl/film/*",
        "https://www.filmweb.pl/serial/*",
        "https://filmweb.pl/serial/*"
      ],
      "js": [
        "src/shared/MediaValidation.js",
        "src/shared/SeerrClient.js",
        "src/shared/MediaExtractor.js",
        "src/shared/SeasonPicker.js",
        "src/shared/NotificationCenter.js",
        "src/shared/UIComponents.js",
        "src/shared/BaseIntegration.js",
        "src/content/filmweb-integration.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://simkl.com/movies/*",
        "https://simkl.com/tv/*",
        "https://simkl.com/anime/*",
        "https://www.simkl.com/movies/*",
        "https://www.simkl.com/tv/*",
        "https://www.simkl.com/anime/*"
      ],
      "js": [
        "src/shared/MediaValidation.js",
        "src/shared/SeerrClient.js",
        "src/shared/MediaExtractor.js",
        "src/shared/SeasonPicker.js",
        "src/shared/NotificationCenter.js",
        "src/shared/UIComponents.js",
        "src/shared/BaseIntegration.js",
        "src/content/simkl-integration.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.justwatch.com/*/*/*",
        "https://justwatch.com/*/*/*",
        "https://*.justwatch.com/*/*/*"
      ],
      "js": [
        "src/shared/MediaValidation.js",
        "src/shared/SeerrClient.js",
        "src/shared/MediaExtractor.js",
        "src/shared/SeasonPicker.js",
        "src/shared/NotificationCenter.js",
        "src/shared/UIComponents.js",
        "src/shared/BaseIntegration.js",
        "src/content/justwatch-integration.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Super Seerr"
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://github.com/jonbiro/super-seerr-extension"
}
